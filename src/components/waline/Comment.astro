---
import config from '@/site-config'
import { cn } from 'astro-pure/utils'

const { class: className } = Astro.props
const twikooVersion = '1.7.22'
const twikooCdn = `${config.npmCDN}/twikoo@${twikooVersion}/dist/twikoo.min.js`
---

{config.integ.twikoo.enable && (
  <comment-component>
    <div id='tcomment' class={cn('not-prose', className)}>
      Comment seems to be stuck. Try to refresh? ✨
    </div>
  </comment-component>
)}

<script is:inline type='module' define:vars={{ envId: config.integ.twikoo.envId, region: config.integ.twikoo.region, twikooCdn, additionalConfigs: config.integ.twikoo.additionalConfigs }}>
  const loadTwikoo = () => {
    if (!globalThis.twikoo || !envId || envId === 'YOUR_TWIKOO_ENV_ID') return
    globalThis.twikoo.init({
      envId,
      el: '#tcomment',
      ...(region ? { region } : {}),
      path: window.location.pathname,
      ...additionalConfigs
    })
  }

  if (envId && envId !== 'YOUR_TWIKOO_ENV_ID') {
    if (globalThis.twikoo) loadTwikoo()
    else {
      const script = document.createElement('script')
      script.src = twikooCdn
      script.onload = loadTwikoo
      document.head.appendChild(script)
    }
  }
</script>
