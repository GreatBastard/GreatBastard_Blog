---
import { cn } from 'astro-pure/utils'
import Pageview from '@/components/waline/Pageview.astro'

interface Props {
  view?: boolean
  comment?: boolean
  class?: string
}

const { view, comment, class: className, ...props } = Astro.props

const path = Astro.url.pathname
---

<div class={cn('text-base text-sm text-muted-foreground', className)} {...props}>
  <span id='twikoo_visitors'>0</span> views
  {
    comment && (
      <>
        {' | '}
        <a href='#tcomment'>
          <span class='twikoo-comment-count' data-path={path}>0</span> comments
        </a>
      </>
    )
  }
</div>

{(view || comment) && <Pageview {comment} />}
